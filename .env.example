# Copy to .env.local for development. Never commit real values; .env* is gitignored.

# Resend API key (https://resend.com/api-keys). When unset, POST /api/enquiry
# answers 503 and the enquiry page falls back to opening a mailto: draft.
RESEND_API_KEY=

# Sender for enquiry emails. Must be on a domain verified in Resend, in the
# form `Name <address>`. Enquiries are delivered to contact@accelryde.com.
ENQUIRY_FROM="Trilyt <enquiry@trilyt.com>"

# Optional: where /join/* and unmatched /api/* are proxied (see next.config.ts).
# BACKEND_ORIGIN=https://oneryde-api.fly.dev
